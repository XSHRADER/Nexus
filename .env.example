# API keys for cloud models. Copy this file to `.env` and fill in the ones
# you have; leave the rest empty. `.env` is git-ignored, so keys never reach
# GitHub. A provider only shows up in NEXUS once its key is set, and nothing
# is sent anywhere until cloud is switched on (sidebar, or nexus.toml).

# Google AI Studio -- free tier. Used for general chat, long documents, images.
GEMINI_API_KEY=

# Groq -- free tier. Very fast chat, and Whisper speech-to-text for voice input.
GROQ_API_KEY=

# OpenRouter -- one key, many models. Pay per use.
OPENROUTER_API_KEY=

# DeepSeek -- cheap deep reasoning. Pay per use.
DEEPSEEK_API_KEY=

# Mistral -- free experiment tier.
MISTRAL_API_KEY=
